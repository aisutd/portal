generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  MEMBER
  OFFICER
  DIRECTOR
  EXECUTIVE
}

enum TEAM {
  AI_ACADEMY
  AI_INNOVATION
  AIM
  MARKETING
  OPERATIONS
  FINANCE
  INDUSTRY
  TECHNOLOGY
  EXECUTIVE
}

enum ProfileCompletionStatus {
  INCOMPLETE
  COMPLETE
}

enum EventStatus {
  UPCOMING
  LIVE
  CLOSED
  ARCHIVED
}

enum EventTag {
  FOOD
  DRINK
  SOCIAL
  LEARN
  WORKSHOP
  NETWORKING
  INDUSTRY
}

enum RSVPStatus {
  GOING
  CANCELED
}

enum AttendanceMethod {
  QR_SCAN
  MANUAL
}

enum ItemType {
  MEAL
  DRINK
  MERCH
  OTHER
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  IN_CONSIDERATION
  ACCEPTED
  REJECTED
  WAITLISTED
  COMPLETED
  ARCHIVED
}

enum ProgramType {
  AI_ACADEMY
  AI_INNOVATION
  AI_MENTORSHIP_MENTOR
  AI_MENTORSHIP_MENTEE
  OFFICER
  OTHER
}

enum MembershipType {
  AIM_MENTOR
  AIM_MENTEE
  AI_ACADEMY
  INNOVATION_LABS
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id            String                  @id @default(cuid())
  clerkId       String                  @unique
  email         String                  @unique
  role          UserRole                @default(MEMBER)
  team          TEAM?
  verifiedAt    DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  drafts        ApplicationDraft[]
  reviews       ApplicationReview[]
  submissions   ApplicationSubmission[]
  auditLogs     AuditLog[]              @relation("AuditActor")
  createdEvents Event[]                 @relation("EventCreator")
  sentEventReminders    Event[]         @relation("EventReminderSender")
  uploadedFiles File[]
  itemScans     ItemScan[]              @relation("ItemScanner")
  memberships   Membership[]
  profile       Profile?
  createdApps   ProgramApplication[]
  rsvps         RSVP[]
  attendances   Attendance[]
}

model Profile {
  id                      String                  @id @default(cuid())
  userId                  String                  @unique
  firstName               String
  lastName                String
  middleName              String
  prefName                String?
  year                    String?
  degree                  String?
  major                   String?
  utdEmail                String?
  utdNetId                String?
  phoneNumber             String?
  personalEmail           String?
  githubUrl               String?
  linkedinUrl             String?
  portfolioUrl            String?
  profileCompletionStatus ProfileCompletionStatus
  resumeFileId            String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  resumeFile              File?                   @relation(fields: [resumeFileId], references: [id])
  user                    User                    @relation(fields: [userId], references: [id])
}

model File {
  id           String                  @id @default(cuid())
  uploadedById String?
  fileName     String
  mimeType     String
  fileSize     Int
  storageKey   String
  createdAt    DateTime                @default(now())
  pdfs         ApplicationSubmission[]
  uploadedBy   User?                   @relation(fields: [uploadedById], references: [id])
  resumes      Profile[]
}

model Event {
  id               String      @id @default(cuid())
  title            String
  description      String
  location         String
  startTime        DateTime
  endTime          DateTime
  status           EventStatus
  capacity         Int?
  visibility       String?
  imageUrl         String?
  eligibilityRules Json?
  isPublished      Boolean    @default(false)
  checkInToken     String     @unique @default(uuid())
  attendances      Attendance[]

  tags             EventTag[]

  /// Which programs this event counts toward for member status. Empty means a
  /// general event that counts for everyone.
  programs         MembershipType[]

  lastReminderSentAt   DateTime?
  lastReminderSentById String?
  lastReminderSentBy   User?   @relation("EventReminderSender", fields: [lastReminderSentById], references: [id])

  createdById      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  createdBy        User        @relation("EventCreator", fields: [createdById], references: [id])
  items            EventItem[]
  rsvps            RSVP[]

  isRsvpOpen       Boolean     @default(true)
}

model RSVP {
  id          String      @id @default(cuid())
  userId      String
  eventId     String
  status      RSVPStatus
  isWalkIn    Boolean     @default(false)
  qrToken     String
  qrExpiresAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  qrPayload   String?
  attendance  Attendance?
  event       Event       @relation(fields: [eventId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
}

model Attendance {
  id          String           @id @default(cuid())
  checkedInAt DateTime         @default(now())
  method      AttendanceMethod?
  qrTokenUsed String?
  
  rsvpId      String?          @unique
  rsvp        RSVP?            @relation(fields: [rsvpId], references: [id], onDelete: SetNull)
  
  eventId     String
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  scans       ItemScan[]

  // Ensures a user can only check into a specific event once
  @@unique([userId, eventId])
}

model EventItem {
  id      String     @id @default(cuid())
  eventId String
  name    String
  type    ItemType
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scans   ItemScan[]

  @@unique([eventId, name])
}

model ItemScan {
  id           String     @id @default(cuid())
  attendanceId String
  eventItemId  String
  scannedAt    DateTime   @default(now())
  scannedById  String?
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  eventItem    EventItem  @relation(fields: [eventItemId], references: [id], onDelete: Cascade)
  scannedBy    User?      @relation("ItemScanner", fields: [scannedById], references: [id])

  @@unique([attendanceId, eventItemId])
}

model ProgramApplication {
  id             String                  @id @default(cuid())
  title          String
  description    String
  roles          String[]                @default([])
  eligibility    String[]                @default([])
  questionsJson  Json?
  requiredProfileFields Json?
  programType    ProgramType
  link           String[]                @default([])
  openAt         DateTime
  closeAt        DateTime
  decisionDate   DateTime?
  visibleToUsers Boolean                 @default(true)
  retentionUntil DateTime?
  createdById    String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  drafts         ApplicationDraft[]
  submissions    ApplicationSubmission[]
  createdBy      User                    @relation(fields: [createdById], references: [id])
}

model ApplicationDraft {
  id              String             @id @default(cuid())
  applicationId   String
  userId          String
  formPayloadJson Json
  stepIndex       Int
  isSubmitted     Boolean            @default(false)
  lastSavedAt     DateTime           @updatedAt
  application     ProgramApplication @relation(fields: [applicationId], references: [id])
  user            User               @relation(fields: [userId], references: [id])

  @@unique([applicationId, userId])
}

model ApplicationSubmission {
  id              String              @id @default(cuid())
  applicationId   String
  userId          String
  versionNumber   Int
  formPayloadJson Json
  pdfFileId       String?
  status          ApplicationStatus
  submittedAt     DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  reviews         ApplicationReview[]
  application     ProgramApplication  @relation(fields: [applicationId], references: [id])
  pdfFile         File?               @relation(fields: [pdfFileId], references: [id])
  user            User                @relation(fields: [userId], references: [id])
}

model ApplicationReview {
  id            String                @id @default(cuid())
  submissionId  String
  reviewerId    String
  status        ApplicationStatus
  notesInternal String?
  updatedAt     DateTime              @updatedAt
  reviewer      User                  @relation(fields: [reviewerId], references: [id])
  submission    ApplicationSubmission @relation(fields: [submissionId], references: [id])

  @@unique([submissionId, reviewerId])
}

model Membership {
  id                  String         @id @default(cuid())
  userId              String
  membershipType      MembershipType
  startDate           DateTime
  endDate             DateTime?
  activeFlag          Boolean        @default(false)
  sourceApplicationId String?
  createdAt           DateTime       @default(now())
  user                User           @relation(fields: [userId], references: [id])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actionType   String
  entityType   String
  entityId     String
  metadataJson Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id])
}